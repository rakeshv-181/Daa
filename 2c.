#include <stdio.h>

int main()
{
    int n, k, i, j;
    scanf("%d", &n);

    int array[n];

    for (i = 0; i < n; i++)
        scanf("%d", &array[i]);

    scanf("%d", &k);

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            if (i != j && array[j] - array[i] == k)
            {
                printf("1");
                return 0;
            }
        }
    }

    printf("0");

    return 0;
}
