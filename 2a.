#include <stdio.h>

int main()
{
    int n, i, j;
    scanf("%d", &n);

    int array[n];

    for (i = 0; i < n; i++)
        scanf("%d", &array[i]);

    for (i = 0; i < n; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (array[i] == array[j])
            {
                printf("%d", array[i]);
                return 0;
            }
        }
    }

    return 0;
}
