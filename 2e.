#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, j, difference, minimum;
    scanf("%d", &n);

    int skills[n];

    for (i = 0; i < n; i++)
        scanf("%d", &skills[i]);

    minimum = abs(skills[0] - skills[1]);

    int first = 0, second = 1;

    for (i = 0; i < n; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            difference = abs(skills[i] - skills[j]);

            if (difference < minimum)
            {
                minimum = difference;
                first = i;
                second = j;
            }
        }
    }

    printf("Pair: (%d, %d)\n", first, second);
    printf("Difference: %d", minimum);

    return 0;
}
