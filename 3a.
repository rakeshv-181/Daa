#include <stdio.h>

int count(int array[], int left, int right, int element)
{
    int total = 0;

    for (int i = left; i <= right; i++)
    {
        if (array[i] == element)
            total++;
    }

    return total;
}

int majority(int array[], int left, int right)
{
    if (left == right)
        return array[left];

    int mid = (left + right) / 2;

    int leftMajority = majority(array, left, mid);
    int rightMajority = majority(array, mid + 1, right);

    if (leftMajority == rightMajority)
        return leftMajority;

    int leftCount = count(array, left, right, leftMajority);
    int rightCount = count(array, left, right, rightMajority);

    if (leftCount > rightCount)
        return leftMajority;
    else
        return rightMajority;
}

int main()
{
    int n;
    scanf("%d", &n);

    int array[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &array[i]);

    printf("%d", majority(array, 0, n - 1));

    return 0;
}
